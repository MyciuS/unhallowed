---
title: Prototype - BEFORE (every player is built with new and the same hard-coded stats)
---
classDiagram
    direction LR
    class World {
        -Dictionary~int, Player~ Players
        +AddPlayer(id int) Player
        +RemovePlayer(id int)
        +Restart()
    }
    class Player {
        +int Id
        +Vector2 Pos
        +int Health
        +List~ItemKind~ Items
        +Stats Stats
        +Player(id int)
        +GiveItem(item ItemKind)
        +TryDamage(halfHearts int) bool
    }
    class Stats {
        +float Speed = 260
        +float Damage = 3.5
        +float FireDelay
        +float ShotSpeed
        +float Range
        +float TearSize
        +int MaxHealth = 6
        +Apply(item ItemKind)
    }
    class ItemKind {
        <<enumeration>>
        DamageUp
        TearsUp
        SpeedUp
        RangeUp
        HeartContainer
        GlassCannon
    }
    World "1" *-- "0..4" Player : new Player(id)
    Player "1" *-- "1" Stats : new Stats()
    Player ..> ItemKind
    Stats ..> ItemKind
