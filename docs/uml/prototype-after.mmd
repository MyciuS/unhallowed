---
title: Prototype - AFTER (players are cloned from character prototypes)
---
classDiagram
    direction LR
    class IPrototype~T~ {
        <<interface>>
        +ShallowClone() T
        +DeepClone() T
    }
    class Character {
        +string Name
        +Stats Stats
        +List~ItemKind~ Items
        +Character(name string, stats Stats)
        +Character(original Character)
        +AddItem(item ItemKind)
        +ShallowClone() Character
        +DeepClone() Character
    }
    class Stats {
        +float Speed
        +float Damage
        +float FireDelay
        +float ShotSpeed
        +float Range
        +float TearSize
        +int MaxHealth
        +Apply(item ItemKind)
        +ShallowClone() Stats
        +DeepClone() Stats
    }
    class CharacterRegistry {
        -List~Character~ _prototypes
        +int Count
        +Register(prototype Character)
        +Create(name string) Character
        +CreateForPlayer(playerId int) Character
        -Clone(prototype IPrototype~Character~)$ Character
        +CreateDefault()$ CharacterRegistry
    }
    class World {
        -CharacterRegistry _characters
        -Dictionary~int, Player~ Players
        +AddPlayer(id int) Player
        +Restart()
    }
    class Player {
        +int Id
        +Character Character
        +Stats Stats
        +List~ItemKind~ Items
        +Player(id int, character Character)
        +GiveItem(item ItemKind)
    }
    class Program {
        +Main(args string[])$
    }
    class PatternDemos {
        <<static>>
        +Run(name string)$
    }
    class PrototypeDemo {
        <<static>>
        +Run()$
        -Compare(title string, copy Func)$
        -CloneThroughInterface()$
        -CompareSpeed()$
        -AddressOf(o object)$ nint
    }
    IPrototype <|.. Character
    IPrototype <|.. Stats
    Character "1" *-- "1" Stats
    CharacterRegistry "1" o-- "*" Character : prototypes
    World --> CharacterRegistry : CreateForPlayer(id)
    World "1" *-- "0..4" Player
    Player "1" --> "1" Character : own deep clone
    Program ..> PatternDemos : --demo prototype
    PatternDemos ..> PrototypeDemo
    PrototypeDemo ..> CharacterRegistry
    CharacterRegistry ..> IPrototype : clones through
    PrototypeDemo ..> Character
