<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="IsaacGame.cs" />
    <Compile Include="Menu.cs" />
    <Compile Include="Core/**/*.cs" />
    <Compile Include="Game/**/*.cs" />
    <Compile Include="Net/**/*.cs" />
    <Compile Include="Rendering/**/*.cs" />
    <Compile Include="Demos/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host runs an embedded ASP.NET Core server with the SignalR hub. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.12" />
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

</Project>
