<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Previous pattern implementations, kept for reference only. -->
    <Compile Remove="old-patterns/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host runs an embedded ASP.NET Core server with the SignalR hub. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.12" />
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

</Project>
